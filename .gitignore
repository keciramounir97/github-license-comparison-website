# ==============================================================================
# Recommended .gitignore for Static & Frontend Web Projects
# Architecture: HTML5, CSS3, Vanilla JS, Node tooling & Environment Management
# ==============================================================================

# 1. Dependency Directories
node_modules/
jspm_packages/
web_modules/

# 2. Build & Distribution Outputs
dist/
build/
out/
.cache/
.parcel-cache/

# 3. Environment Variables & Secret Credentials
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
credentials.json

# 4. Logs & Debugging Artefacts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. Operating System Metadata Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 6. IDEs & Code Editor Workspaces
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*~

# 7. Testing & Coverage Reports
coverage/
.nyc_output/
cypress/videos/
cypress/screenshots/
